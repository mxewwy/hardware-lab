{
  "multipart": [
    {
      "apply": {
        "model": "hardware_lab:block/digital_wire_core"
      }
    },
    {
      "when": { "north": true },
      "apply": {
        "model": "hardware_lab:block/digital_wire_north"
      }
    },
    {
      "when": { "south": true },
      "apply": {
        "model": "hardware_lab:block/digital_wire_south"
      }
    },
    {
      "when": { "east": true },
      "apply": {
        "model": "hardware_lab:block/digital_wire_east"
      }
    },
    {
      "when": { "west": true },
      "apply": {
        "model": "hardware_lab:block/digital_wire_west"
      }
    },
    {
      "when": { "up": true },
      "apply": {
        "model": "hardware_lab:block/digital_wire_up"
      }
    },
    {
      "when": { "down": true },
      "apply": {
        "model": "hardware_lab:block/digital_wire_down"
      }
    }
  ]
}
